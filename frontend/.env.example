# Where the browser sends /api/*. Leave EMPTY for same origin: next.config.mjs rewrites
# /api/:path* to the backend, and a same-origin request is never CORS-preflighted.
NEXT_PUBLIC_API_BASE_URL=
# Server-side proxy target for /api/* (defaults to http://localhost:8180).
API_URL=http://localhost:8180
# Older name for API_URL, still read when API_URL is empty.
API_PROXY_TARGET=
# Google Identity Services client id. Empty = the dev Google chooser (/api/auth/google/dev,
# local and dev API profiles only); set = the real "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APP_NAME=VirtualBiz
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Which deployment this build is for: local | dev | uat | prod.
NEXT_PUBLIC_APP_ENV=local
# true = pages read src/lib/mock/repo.ts instead of the API. Auth, account and businesses
# always use the API; marketplace and workspace data stay on the mock until Phase 2.
NEXT_PUBLIC_USE_MOCKS=true
