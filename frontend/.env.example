# Where the browser sends /api/*. Leave EMPTY for same origin: next.config.mjs rewrites
# /api/:path* to the backend, and a same-origin request is never CORS-preflighted.
NEXT_PUBLIC_API_BASE_URL=
# Server-side proxy target for /api/* (defaults to http://localhost:8180).
API_URL=http://localhost:8180
# Older name for API_URL, still read when API_URL is empty.
API_PROXY_TARGET=
# Google Identity Services client id. Empty = the dev Google chooser (/api/auth/google/dev,
# local and dev API profiles only); set = the real "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase (docs/ops/firebase.md): sign-in with Google and email + password, and push notifications.
# Firebase console → Project settings → Your apps → Web app. Empty = VirtualBiz signs in by itself.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=virtaulbiz.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=virtaulbiz
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging → Web Push certificates → key pair. Empty = no push toggle.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Local Auth emulator, e.g. http://127.0.0.1:9099 (testing only)
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=
NEXT_PUBLIC_APP_NAME=VirtualBiz
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Which deployment this build is for: local | dev | uat | prod.
NEXT_PUBLIC_APP_ENV=local
