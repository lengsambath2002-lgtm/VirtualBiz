# Copy to backend/.env (git-ignored) for local runs. Deployed environments set these as real
# environment variables. Variables with a default in application*.yml are optional.

# Profile: local | dev | uat | prod (default: local)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL 15+ (local defaults: jdbc:postgresql://127.0.0.1:5433/vbiz, vbiz / vbiz).
# Port 5433: the shared local Postgres also hosts other projects' databases.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/vbiz
DATABASE_USERNAME=vbiz
DATABASE_PASSWORD=vbiz
DATABASE_POOL_SIZE=20

# HTTP
SERVER_PORT=8180

# Auth. VBIZ_JWT_SECRET is required outside the local profile (at least 32 bytes), e.g.
# `openssl rand -base64 48`. Google sign-in stays NOT_CONFIGURED until a client id is set.
VBIZ_JWT_SECRET=
VBIZ_GOOGLE_CLIENT_ID=

# Build / ops
VBIZ_VERSION=dev
LOG_DIR=./logs

# Uploaded images (profile, shop and product photos). Mount a persistent volume here.
VBIZ_STORAGE_DIR=./data/uploads
