# Copy to backend/.env (git-ignored) for local runs. Deployed environments set these as real
# environment variables. Variables with a default in application*.yml are optional.

# Profile: local | dev | uat | prod (default: local)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL 15+ (local defaults: jdbc:postgresql://127.0.0.1:5433/vbiz, vbiz / vbiz).
# Port 5433: the shared local Postgres also hosts other projects' databases.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/vbiz
DATABASE_USERNAME=vbiz
DATABASE_PASSWORD=vbiz
DATABASE_POOL_SIZE=20

# HTTP
SERVER_PORT=8180

# Auth. VBIZ_JWT_SECRET is required outside the local profile (at least 32 bytes), e.g.
# `openssl rand -base64 48`. Google sign-in stays NOT_CONFIGURED until a client id is set.
VBIZ_JWT_SECRET=

# Encrypts staff two-step sign-in keys at rest. Required outside the local profile:
# 32 random bytes, Base64, e.g. `openssl rand -base64 32`. Keep it with the JWT secret.
VBIZ_DATA_KEY=

# Web app address, used in staff invite emails.
VBIZ_APP_URL=

# First start only, when there is no super-admin yet: the first super-admin's account. The
# password is temporary (it must be changed at first sign-in) and must meet the staff password
# rules (12+ characters, upper and lower case, a digit and a symbol). Remove these afterwards.
VBIZ_BOOTSTRAP_ADMIN_EMAIL=
VBIZ_BOOTSTRAP_ADMIN_NAME=
VBIZ_BOOTSTRAP_ADMIN_PASSWORD=
VBIZ_GOOGLE_CLIENT_ID=

# Build / ops
VBIZ_VERSION=dev
LOG_DIR=./logs

# Uploaded images (profile, shop and product photos). Mount a persistent volume here.
VBIZ_STORAGE_DIR=./data/uploads

# Email (docs/ops/email.md). Off: emails are only logged. Locally the `local` profile sends to
# Mailpit (localhost:1025). Gmail: an App Password, never the account password.
VBIZ_MAIL_ENABLED=
VBIZ_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_AUTH=
SMTP_STARTTLS=
SMTP_USERNAME=
SMTP_PASSWORD=
